+}
+
+.testimonial-card {
+  margin: 0;
+  padding: 2rem;
+  background: var(--surface-card);
+  border: 1px solid var(--border-subtle);
+  border-radius: 12px;
+}
+
+.testimonial-card blockquote {
+  margin: 0 0 1.25rem;
+  padding: 0;
+  border: none;
+  font-size: 1.05rem;
+  line-height: 1.6;
+  color: var(--text-primary);
+}
+
+.testimonial-card figcaption {
+  font-size: 0.9rem;
+  color: var(--text-muted);
+}
+
+.testimonial-card figcaption strong {
+  display: block;
+  color: var(--text-primary);
+  font-weight: 600;
+}
+
+/* ==========================================
+   PAGE HEADER ACTIONS (work page)
+   ========================================== */
+
+.page-header-actions {
+  margin-top: 1.5rem;
+  display: flex;
+  gap: 0.75rem;
+  flex-wrap: wrap;
+}
+
+.page-header-actions .btn-outline {
+  display: inline-flex;
+  align-items: center;
+  padding: 0.6rem 1.25rem;
+  border-radius: 8px;
+  font-weight: 600;
+  font-size: 0.9rem;
+  text-decoration: none;
+}
+
+/* ==========================================
+   FEATURED CASE STUDY (work page)
+   ========================================== */
+
+.featured-case-study {
+  display: block;
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 2rem;
+  background: var(--surface-card);
+  border: 1px solid var(--border-subtle);
+  border-left: 4px solid var(--accent-blue);
+  border-radius: 12px;
+  text-decoration: none;
+  transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
+}
+
+.featured-case-study:hover {
+  transform: translateY(-3px);
+  box-shadow: 0 10px 28px rgba(37, 99, 235, 0.12);
+  text-decoration: none;
+}
+
+.fcs-tag {
+  display: inline-block;
+  font-size: 0.72rem;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--accent-blue);
+  margin-bottom: 0.6rem;
+}
+
+.featured-case-study h3 {
+  margin: 0 0 0.6rem;
+  font-size: 1.45rem;
+  font-weight: 700;
+  color: var(--text-primary);
+  line-height: 1.25;
+}
+
+.featured-case-study p {
+  margin: 0 0 0.9rem;
+  color: var(--text-secondary);
+  line-height: 1.6;
+  max-width: 700px;
+}
+
+.fcs-link {
+  font-weight: 600;
+  color: var(--accent-blue);
+  font-size: 0.92rem;
+}
+
+/* ==========================================
+   OPEN SOURCE TAB (work page)
+   ========================================== */
+
+.oss-list {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: 1.25rem;
+  max-width: 860px;
+}
+
+.oss-card {
+  padding: 1.75rem;
+  background: var(--surface-card);
+  border: 1px solid var(--border-subtle);
+  border-radius: 12px;
+}
+
+.oss-header {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  margin-bottom: 0.75rem;
+}
+
+.oss-icon {
+  font-size: 1.5rem;
+  line-height: 1;
+}
+
+.oss-org {
+  margin: 0;
+  font-size: 1.15rem;
+  font-weight: 700;
+  color: var(--text-primary);
+}
+
+.oss-blurb {
+  margin: 0 0 1rem;
+  color: var(--text-secondary);
+  line-height: 1.6;
+}
+
+.oss-links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.5rem 1.25rem;
+}
+
+.oss-links a {
+  font-size: 0.85rem;
+  font-weight: 500;
+  color: var(--accent-blue);
+  text-decoration: none;
+}
+
+.oss-links a:hover {
+  text-decoration: underline;
+}
+
+/* ==========================================
+   EXPERIENCE CASE STUDY LINK (work page)
+   ========================================== */
+
+.exp-case-link {
+  display: inline-block;
+  margin: 0.25rem 0 0.75rem;
+  font-size: 0.88rem;
+  font-weight: 600;
+  color: var(--accent-blue);
+  text-decoration: none;
+}
+
+.exp-case-link:hover {
+  text-decoration: underline;
+}
+
+/* ==========================================
+   RESPONSIVE — new components
+   ========================================== */
+
+@media (max-width: 768px) {
+  .metrics-grid {
+    grid-template-columns: repeat(2, 1fr);
+    gap: 1rem;
+  }
+  .testimonials-grid {
+    grid-template-columns: 1fr;
+  }
+  .metric-value {
+    font-size: 2rem;
+  }
+  .featured-case-study h3 {
+    font-size: 1.25rem;
+  }
+}
+
+@media (max-width: 480px) {
+  .metrics-grid {
+    grid-template-columns: 1fr;
+  }
+}
